#!/usr/bin/env bash
# Script that prints messages indefinitely and handles signals using a PID file

PID_FILE="/var/run/myscript.pid"

cleanup() {
  rm -f "$PID_FILE"
}

on_sigterm() {
  echo "I hate the kill command"
  cleanup
  exit 0
}

on_sigint() {
  echo "Y U no love me?!"
}

on_sigquit() {
  cleanup
  exit 0
}

echo "$BASHPID" > "$PID_FILE"

trap on_sigterm SIGTERM
trap on_sigint SIGINT
trap on_sigquit SIGQUIT

while true; do
  echo "To infinity and beyond"
  sleep 2
done
