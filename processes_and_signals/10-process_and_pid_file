#!/usr/bin/env bash
# Creates /var/run/myscript.pid with its PID and prints a message on SIGTERM

PID_FILE="/var/run/myscript.pid"

cleanup() {
    echo "I hate the kill command"
    rm -f "$PID_FILE"
    exit 0
}

trap cleanup SIGTERM

# Create PID file immediately

echo "$BASHPID" > "$PID_FILE"

while true
do
    sleep 1
done
